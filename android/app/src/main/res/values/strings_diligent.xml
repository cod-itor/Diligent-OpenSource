<?xml version="1.0" encoding="utf-8"?>
<!--
    Diligent's own strings, kept apart from VSCodroid's strings.xml so updates
    from VSCodroid merge cleanly.

    English only for now, on purpose: Mobile view will be redesigned many times
    before release, and translating every draft would be wasted work. Other
    languages fall back to these English strings until the design settles; the
    translations then come in one pass, into values-xx/strings_diligent.xml.
    MissingTranslation is ignored for this file alone, so lint still catches a
    string missing from VSCodroid's translated strings.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">

    <!-- Mobile view tabs -->
    <string name="diligent_tab_projects">Projects</string>
    <string name="diligent_tab_files">Files</string>
    <string name="diligent_tab_editor">Editor</string>
    <string name="diligent_tab_terminal">Terminal</string>
    <string name="diligent_tab_more">More</string>

    <!-- Top bar -->
    <string name="diligent_menu">Menu</string>
    <string name="diligent_no_project">No project open</string>

    <!-- Editor action bar -->
    <string name="diligent_action_run">Run</string>
    <string name="diligent_action_stop">Stop</string>
    <string name="diligent_action_preview">Preview</string>
    <string name="diligent_action_save">Save</string>
    <string name="diligent_action_search">Search</string>
    <string name="diligent_action_commands">Commands</string>
    <string name="diligent_action_undo">Undo</string>

    <!-- Top bar menu -->
    <string name="diligent_menu_desktop_view">Desktop view</string>
    <string name="diligent_menu_settings">Settings</string>

    <!-- Placeholder while a screen is being built -->
    <string name="diligent_screen_projects">Your projects</string>
    <string name="diligent_screen_files">Files</string>
    <string name="diligent_screen_more">More</string>
    <string name="diligent_screen_run">Run</string>

    <!-- Big screen suggestion -->
    <string name="diligent_suggest_desktop_title">Switch to Desktop view?</string>
    <string name="diligent_suggest_desktop_body">This screen has room for the full VS Code layout, which works well with a keyboard. Your files and terminals stay open.</string>
    <string name="diligent_suggest_mobile_title">Switch back to Mobile view?</string>
    <string name="diligent_suggest_mobile_body">The big screen is gone. Mobile view is easier to use on the phone.</string>
    <string name="diligent_suggest_switch">Switch</string>
    <string name="diligent_suggest_not_now">Not now</string>

    <!-- First launch: choose a view -->
    <string name="diligent_choose_view_title">How do you want to code?</string>
    <string name="diligent_view_mobile">Mobile view</string>
    <string name="diligent_view_mobile_badge">Recommended for phones</string>
    <string name="diligent_view_mobile_body">Touch-first and simple, made for one hand.</string>
    <string name="diligent_view_desktop">Desktop view</string>
    <string name="diligent_view_desktop_body">The full VS Code interface. Best with a keyboard, a tablet, DeX or a monitor.</string>
    <string name="diligent_choose_view_footer">You can switch at any time.</string>

    <!-- Shared -->
    <string name="diligent_editor_starting">The editor is still starting. Try again in a moment.</string>
    <string name="diligent_coming_soon">Coming soon</string>
</resources>
