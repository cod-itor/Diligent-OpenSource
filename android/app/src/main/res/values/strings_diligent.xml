<?xml version="1.0" encoding="utf-8"?>
<!--
    Diligent's own strings, kept apart from VSCodroid's strings.xml so updates
    from VSCodroid merge cleanly.

    English only for now, on purpose: Mobile view will be redesigned many times
    before release, and translating every draft would be wasted work. Other
    languages fall back to these English strings until the design settles; the
    translations then come in one pass, into values-xx/strings_diligent.xml.
    MissingTranslation is ignored for this file alone, so lint still catches a
    string missing from VSCodroid's translated strings.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">

