{
  "name": "diligent-bridge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.5",
  "publisher": "diligent",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:diligent.bridge.updateTasks",
    "onCommand:diligent.bridge.kitProgress",
    "onCommand:diligent.bridge.getHealth",
    "onCommand:diligent.bridge.installToolchain"
  ],
  "browser": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000
    },
    "commands": [
      {
        "command": "diligent.switchToMobileView",
        "title": "%command.switchToMobileView%",
        "category": "Diligent"
      }
    ]
  }
}
