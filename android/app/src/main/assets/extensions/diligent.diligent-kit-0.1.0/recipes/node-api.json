{
  "id": "node-api",
  "title": "Node.js API",
  "summary": "An Express web API with two routes",
  "sizeMB": 10,
  "needs": {
    "toolchains": [],
    "minFreeMB": 30,
    "internet": "once"
  },
  "tested": {
    "express": "5"
  },
  "steps": [
    {
      "type": "write",
      "title": "Write package.json",
      "template": "node-api/package.json",
      "path": "package.json"
    },
    {
      "type": "write",
      "title": "Write index.js",
      "template": "node-api/index.js",
      "path": "index.js"
    },
    {
      "type": "write",
      "title": "Write .gitignore",
      "template": "node-api/gitignore",
      "path": ".gitignore"
    },
    {
      "type": "run",
      "title": "Install Express",
      "command": "npm install --no-fund --no-audit",
      "timeoutSec": 900
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "start",
          "command": "npm start",
          "port": 3000
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that the API answers",
      "profile": "start",
      "expect": {
        "port": 3000
      },
      "timeoutSec": 60
    }
  ]
}
