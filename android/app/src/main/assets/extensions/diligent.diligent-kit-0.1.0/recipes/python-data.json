{
  "id": "python-data",
  "title": "Python for data",
  "summary": "numpy and pandas in a virtual environment, with a script and a notebook",
  "sizeMB": 250,
  "needs": {
    "toolchains": [],
    "minFreeMB": 400,
    "internet": "once"
  },
  "tested": {
    "python": "3.12",
    "numpy": "2",
    "pandas": "2"
  },
  "steps": [
    {
      "type": "write",
      "title": "Write analysis.py",
      "template": "python-data/analysis.py",
      "path": "analysis.py"
    },
    {
      "type": "write",
      "title": "Write notebook.ipynb",
      "template": "python-data/notebook.ipynb",
      "path": "notebook.ipynb"
    },
    {
      "type": "write",
      "title": "Write .gitignore",
      "template": "python-data/gitignore",
      "path": ".gitignore"
    },
    {
      "type": "run",
      "title": "Create the virtual environment",
      "command": "python3 -m venv .venv",
      "timeoutSec": 300
    },
    {
      "type": "run",
      "title": "Install numpy, pandas and the notebook kernel",
      "command": ".venv/bin/python -m pip install --prefer-binary numpy pandas ipykernel",
      "timeoutSec": 1800
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "analysis",
          "command": ".venv/bin/python analysis.py"
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that the analysis runs",
      "profile": "analysis",
      "expect": {
        "output": "rows, average"
      },
      "timeoutSec": 120
    }
  ]
}
