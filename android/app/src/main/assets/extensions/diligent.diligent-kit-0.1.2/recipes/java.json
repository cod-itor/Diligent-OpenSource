{
  "id": "java",
  "title": "Java program",
  "summary": "Hello World in Java 21, run straight from the source file",
  "language": "Java",
  "sizeMB": 190,
  "needs": {
    "toolchains": [
      "toolchain_java"
    ],
    "minFreeMB": 5,
    "internet": "pack"
  },
  "tested": {
    "java": "21"
  },
  "steps": [
    {
      "type": "toolchain",
      "title": "Install the Java 21 pack",
      "pack": "toolchain_java"
    },
    {
      "type": "write",
      "title": "Write Main.java",
      "template": "java/Main.java",
      "path": "Main.java"
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "main",
          "command": "java Main.java"
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that it runs",
      "profile": "main",
      "expect": {
        "output": "^Hello from "
      },
      "timeoutSec": 120
    }
  ]
}
