{
  "id": "nextjs",
  "title": "Next.js app",
  "summary": "Next.js with the App Router, run with webpack on port 3000",
  "language": "JavaScript",
  "sizeMB": 450,
  "needs": {
    "toolchains": [],
    "minFreeMB": 900,
    "internet": "once"
  },
  "tested": {
    "create-next-app": "16",
    "next": "16"
  },
  "steps": [
    {
      "type": "run",
      "title": "Create the Next.js app",
      "command": "mkdir -p .kit-new && cd .kit-new && npx --yes create-next-app@16 {{pkg}} --yes --use-npm --disable-git",
      "timeoutSec": 1800
    },
    {
      "type": "run",
      "title": "Move it into the project folder",
      "command": "shopt -s dotglob && mv .kit-new/{{pkg}}/* . && rm -rf .kit-new"
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "dev",
          "command": "npm run dev -- --webpack --hostname 127.0.0.1 --port 3000",
          "port": 3000
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that the dev server starts",
      "profile": "dev",
      "expect": {
        "port": 3000
      },
      "timeoutSec": 300
    }
  ]
}
