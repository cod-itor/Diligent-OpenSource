{
  "id": "c-cpp",
  "title": "C++ program",
  "summary": "Hello World in C++, built with clang",
  "language": "C++",
  "sizeMB": 265,
  "needs": {
    "toolchains": [
      "toolchain_cpp"
    ],
    "minFreeMB": 5,
    "internet": "pack"
  },
  "tested": {
    "clang": "21"
  },
  "steps": [
    {
      "type": "toolchain",
      "title": "Install the C/C++ pack",
      "pack": "toolchain_cpp"
    },
    {
      "type": "write",
      "title": "Write main.cpp",
      "template": "c-cpp/main.cpp",
      "path": "main.cpp"
    },
    {
      "type": "write",
      "title": "Write .gitignore",
      "template": "c-cpp/gitignore",
      "path": ".gitignore"
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "main",
          "command": "clang++ -std=c++20 -O1 -o hello main.cpp && ./hello"
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that it builds and runs",
      "profile": "main",
      "expect": {
        "output": "^Hello from "
      },
      "timeoutSec": 180
    }
  ]
}
