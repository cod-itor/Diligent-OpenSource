{
  "id": "python-cli",
  "title": "Python command-line tool",
  "summary": "A Python program with options and --help, using argparse",
  "language": "Python",
  "sizeMB": 25,
  "needs": {
    "toolchains": [],
    "minFreeMB": 40,
    "internet": "no"
  },
  "tested": {
    "python": "3.14"
  },
  "steps": [
    {
      "type": "write",
      "title": "Write main.py",
      "template": "python-cli/main.py",
      "path": "main.py"
    },
    {
      "type": "write",
      "title": "Write .gitignore",
      "template": "python-cli/gitignore",
      "path": ".gitignore"
    },
    {
      "type": "run",
      "title": "Create the virtual environment",
      "command": "python3 -m venv .venv",
      "timeoutSec": 300
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "main",
          "command": ".venv/bin/python main.py --times 2"
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that it runs",
      "profile": "main",
      "expect": {
        "output": "^Hello from "
      },
      "timeoutSec": 60
    }
  ]
}
