{
  "id": "django",
  "title": "Django website",
  "summary": "A Python website with Django, its admin and a SQLite database",
  "language": "Python",
  "sizeMB": 70,
  "needs": {
    "toolchains": [],
    "minFreeMB": 120,
    "internet": "once"
  },
  "tested": {
    "python": "3.14",
    "django": "6"
  },
  "steps": [
    {
      "type": "write",
      "title": "Write requirements.txt",
      "template": "django/requirements.txt",
      "path": "requirements.txt"
    },
    {
      "type": "write",
      "title": "Write .gitignore",
      "template": "django/gitignore",
      "path": ".gitignore"
    },
    {
      "type": "run",
      "title": "Create the virtual environment",
      "command": "python3 -m venv .venv",
      "timeoutSec": 300
    },
    {
      "type": "run",
      "title": "Install Django",
      "command": ".venv/bin/python -m pip install -r requirements.txt",
      "timeoutSec": 900
    },
    {
      "type": "run",
      "title": "Create the Django project",
      "command": ".venv/bin/python -m django startproject site_config .",
      "timeoutSec": 120
    },
    {
      "type": "run",
      "title": "Set up the database",
      "command": ".venv/bin/python manage.py migrate --no-input",
      "timeoutSec": 300
    },
    {
      "type": "profile",
      "title": "Add the run profile",
      "profiles": [
        {
          "name": "serve",
          "command": ".venv/bin/python manage.py runserver 127.0.0.1:8000",
          "port": 8000
        }
      ]
    },
    {
      "type": "test",
      "title": "Check that the site answers",
      "profile": "serve",
      "expect": {
        "port": 8000
      },
      "timeoutSec": 120
    }
  ]
}
